NODE_ENV=development
PORT=3000
# Additional browser origins; Capacitor 7 Android (https://localhost) and iOS
# (capacitor://localhost) are built into the API CORS allowlist.
# Do not use '*'; comma-separate any other trusted web frontends.
ALLOWED_ORIGINS=http://localhost:8100,http://localhost:4200
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative local Firebase Admin credentials: GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
DEVICE_KEY_PEPPER=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
PUSHER_ENABLED=false
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1
FCM_ENABLED=false
# Enable only at the separately approved clean re-provisioning cutover;
# denies unclaimed legacy reads and the old fleet channel.
P2_STRICT_OWNERSHIP=false
OFFLINE_MINUTES=60
CRON_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
MAX_WORKER_JOBS=20

# Firestore-backed, cross-instance quota for mutating/auth endpoints.
# Paid Firestore TTL is optional. The CRON_SECRET-protected jobs/dispatch worker prunes expired rate-window records in bounded batches without TTL.
RATE_LIMIT_BOOTSTRAP=30
RATE_LIMIT_TELEMETRY=240
RATE_LIMIT_USER_CHANGE=60
RATE_LIMIT_PUSH_REGISTER=30
RATE_LIMIT_REALTIME_AUTH=120
RATE_LIMIT_CLAIM_ADMIN=10
RATE_LIMIT_PAIR_START=6
RATE_LIMIT_CLAIM_REQUEST=10
RATE_LIMIT_PAIR_CONFIRM=12
RATE_LIMIT_INVITE=10
RATE_LIMIT_INVITE_ACCEPT=15

# Optional P2-13 avatar provider; no unsigned browser upload preset.
# Leave unset until account/secret provisioning is separately approved.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RATE_LIMIT_AVATAR_UPLOAD=12
RATE_LIMIT_AVATAR_DELETE=6

# Phase 2 ONE-COMMAND TEST RUNNER: npm run verify:p2
# Leave unconfigured provider fields empty: runner reports SKIP, never invents secrets.
# Hosting domain: e.g. your-project.firebaseapp.com (hostname only, NO https://)
P2_APP_LINK_HOST=
# Android real APK signing-certificate SHA-256 as AA:BB:... (32 bytes).
P2_ANDROID_SHA256=
# Optional one-time email sender (SMTP or Resend). Recipient may use Gmail.
# Domain/from must be verified in email provider. Default DOES NOT send.
P2_EMAIL_API_KEY=
P2_EMAIL_FROM=
P2_EMAIL_TEST_TO=
P2_EMAIL_TEST_SEND=false
# Cloudinary cloud name + key + secret above trigger a disposable signed upload,
# public delivery test, and signed destroy on each verify:p2 invocation.
# All IoT telemetry, claimed owner creation, sharing, alert, FCM dispatch fixtures:
# DEMO FIREBASE EMULATORS ONLY. NEVER run live Firestore migrations in verify:p2.

# Sending actual invitation email is opt-in; disabled by default.
# Uses the selected P2_EMAIL_PROVIDER and configured verified sender.
P2_INVITE_EMAIL_ENABLED=false

# Optional SAFE read-only HTTPS staging acceptance (no synthetic cloud writes).
# The token must be a short-lived ID token of a seeded staging test account.
P2_STAGING_API_BASE=
P2_STAGING_ID_TOKEN=
# Optional negative test: outsider must receive HTTP 403/404 for owned device.
P2_STAGING_OUTSIDER_ID_TOKEN=
P2_STAGING_PRIVATE_DEVICE_ID=
# Optional TEST-ONLY external simulator sends. Never set without dedicated
# test Pusher app / FCM token, all synthetic Firestore changes stay on emulators.
THESIS_PROVIDER_CONFIRM=
THESIS_FCM_PROJECT_ID=
THESIS_FCM_TEST_TOKEN=
THESIS_FCM_CREDENTIALS_FILE=

# P2-15 Firebase Auth verification / reset by Firebase Admin + Resend.
# Disabled by default: the mobile app will use the existing Firebase template
# emails until API is separately deployed and these settings are enabled.
# This avoids the Firebase Console EMAIL_TEMPLATE_UPDATE_NOT_ALLOWED restriction.
# Server-generated one-time Firebase codes are sent to the custom Hosting
# /auth/action page. That page must ALREADY be deployed over HTTPS.
# Set true ONLY AFTER verifying Hosting, sender and receiving test account.
P2_AUTH_EMAIL_ENABLED=false
# PUBLIC Firebase web API key from the same Firebase project (not Admin secret).
# Used only to verify the authenticity of Admin-generated action links.
P2_FIREBASE_WEB_API_KEY=
# Reuses P2_EMAIL_API_KEY, P2_EMAIL_FROM and DEVICE_KEY_PEPPER.
# Resend's onboarding@resend.dev can only send to allowed account/test addresses.
# Other recipients require your OWN verified sender domain in Resend.
# Password resets always return HTTP 202 regardless of account existence,
# provider status or rate limit; no raw email/OTP/action code is logged.

# =======================================================================
# PRIMARY BlueGuard Firebase Admin transactional mail for dev/staging/demo:
# Gmail SMTP with dedicated Google account + 16-character Google App Password.
# No Firebase Auth user/password or API token is sent to SMTP: Firebase still
# generates, expires and validates all one-time verification/reset codes.
# Provider choice is explicit. Existing Resend behavior remains selectable:
#   smtp = Gmail/SMTP (recommended for demo); resend = legacy HTTPS provider.
# For first-time rollout set P2_AUTH_EMAIL_ENABLED=false until email:check PASS.
P2_EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Secret Google App Password. Spaces in copied 4-character groups tolerated.
# DO NOT enter your normal Google password or commit this value.
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_FROM must use the same mailbox as SMTP_USER, e.g.:
# SMTP_FROM=BlueGuard Buoy <blueguard-mailer@gmail.com>
# Port 587 works with SMTP_SECURE=false and required STARTTLS if port 465 is
# unavailable; encrypted TLS validation can never be disabled.
#
# npm run email:check                # SMTP TLS/auth only, zero emails sent
# npm run email:check -- --send      # sends ONE harmless email to
#                                  # P2_EMAIL_TEST_TO then checks SMTP accept
# npm run verify:p2                 # sender uses SMTP if selected above,
#                                  # only sends if P2_EMAIL_TEST_SEND=true
#
# For dev/staging/prod demo: explicitly set this variable true only AFTER
# deploying the API with SMTP secrets and verifying TLS/sending to inbox.
# P2_AUTH_EMAIL_ENABLED=false       # Defined above; do not duplicate keys
#
# Existing Firebase web API key must match Firebase project and custom
# Hosting /auth/action page. No Firebase Auth Templates edits are necessary.
# Gmail SMTP is subject to per-account rate limits/anti-abuse controls.
# For high-volume production use a verified-domain transactional service.
