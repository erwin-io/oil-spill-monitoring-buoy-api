NODE_ENV=development
PORT=3000
# Additional browser origins; Capacitor 7 Android (https://localhost) and iOS
# (capacitor://localhost) are built into the API CORS allowlist.
# Do not use '*'; comma-separate any other trusted web frontends.
ALLOWED_ORIGINS=http://localhost:8100,http://localhost:4200
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative local Firebase Admin credentials: GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
DEVICE_KEY_PEPPER=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
PUSHER_ENABLED=false
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1
FCM_ENABLED=false
# Enable only at the separately approved clean re-provisioning cutover;
# denies unclaimed legacy reads and the old fleet channel.
P2_STRICT_OWNERSHIP=false
OFFLINE_MINUTES=60
CRON_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
MAX_WORKER_JOBS=20

# Firestore-backed, cross-instance quota for mutating/auth endpoints.
# Paid Firestore TTL is optional. The CRON_SECRET-protected jobs/dispatch worker prunes expired rate-window records in bounded batches without TTL.
RATE_LIMIT_BOOTSTRAP=30
RATE_LIMIT_TELEMETRY=240
RATE_LIMIT_USER_CHANGE=60
RATE_LIMIT_PUSH_REGISTER=30
RATE_LIMIT_REALTIME_AUTH=120
RATE_LIMIT_CLAIM_ADMIN=10
RATE_LIMIT_PAIR_START=6
RATE_LIMIT_CLAIM_REQUEST=10
RATE_LIMIT_PAIR_CONFIRM=12
RATE_LIMIT_INVITE=10
RATE_LIMIT_INVITE_ACCEPT=15

# Optional P2-13 avatar provider; no unsigned browser upload preset.
# Leave unset until account/secret provisioning is separately approved.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RATE_LIMIT_AVATAR_UPLOAD=12
RATE_LIMIT_AVATAR_DELETE=6
